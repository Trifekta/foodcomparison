{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker name in the Cloudflare dashboard. Workers Builds
  // deploys to the project name, so a mismatch here is rejected at deploy time.
  "name": "foodcomparison",

  // Our own entry, which wraps the one OpenNext generates. The wrapper exists
  // only to add a `scheduled` export for the cron trigger below; every other
  // export is passed straight through. See worker/index.ts.
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",

  // nodejs_compat: Next.js and supabase-js need Node built-ins.
  // global_fetch_strictly_public: outbound fetch goes to the public internet
  // rather than looping back into this Worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Do not delete variables set in the dashboard.
  //
  // Wrangler treats this file as the source of truth by default, so `wrangler
  // deploy` REMOVES any plain-text variable it does not find here. This project
  // is configured through the Cloudflare dashboard, so every deploy was quietly
  // wiping WEB_PUSH_PUBLIC_KEY, WEB_PUSH_SUBJECT and anything else set as a
  // Variable rather than a Secret - and a deploy happens on every merge, so the
  // setting worked until the next time anybody shipped anything.
  //
  // Secrets were never affected, which is why the service role key survived and
  // the site kept working while notifications kept dying.
  "keep_vars": true,

  // "Is anything still waiting?", asked by Cloudflare rather than by a
  // third-party scheduler. Every five minutes, against a promise of five: a
  // submission is chased once it has been unanswered for ten, so this is
  // frequent enough that the reminder is never much later than that and rare
  // enough to be free.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // A ceiling well below the 30s this plan allows by default.
  //
  // Not a performance setting - a blast radius. A request that has stopped
  // making progress bills for every millisecond it spends spinning, and without
  // this it spins until Cloudflare's own limit catches it. Ten seconds is far
  // more than any render here needs, so nothing legitimate should ever reach
  // it; anything that does is a bug, and this turns it into a 1102 in the logs
  // rather than a quiet line on the invoice.
  //
  // Applies to the cron invocation too. The chaser is well inside it: its work
  // is Supabase queries and a handful of push sends, and waiting on the network
  // costs no CPU time - only the P-256 encryption of each payload does.
  "limits": {
    "cpu_ms": 10000
  },

  // STAGING - a separate Worker, never a version of the production one.
  //
  // The top level above IS production, and stays exactly as it was: a plain
  // `wrangler deploy` (the production Workers Builds deploy command) still
  // deploys `foodcomparison` and nothing else. Staging is only ever reached with
  // `--env staging`, which deploys `foodcomparison-staging` - its own Worker,
  // with its own secrets, its own build variables and its own workers.dev URL.
  //
  // Build it with `npm run cf:build:staging`, never plain `cf:build`: that script
  // refuses production Supabase values and a production NEXT_PUBLIC_APP_URL, and
  // switches the Meta Pixel off. SNIPSAVOR_ENV below is what makes the Worker
  // check the same thing again at runtime (lib/env.ts). Full setup:
  // docs/staging/README.md.
  //
  // Everything that matters is repeated rather than inherited, so reading this
  // block is enough to know what staging runs with. Wrangler never inherits
  // `vars` from the top level in any case.
  //
  // Side effect on production: a plain `wrangler deploy` now warns that no
  // target environment was given. It still deploys the top level (production),
  // exactly as before; `wrangler deploy --env=""` says so explicitly.
  "env": {
    "staging": {
      "name": "foodcomparison-staging",
      "workers_dev": true,
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": {
        "enabled": true
      },
      // keep_vars is top-level only; the setting above applies here too.
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "limits": {
        "cpu_ms": 10000
      },
      "vars": {
        // Turns on the runtime isolation check. Plain and committed on purpose:
        // it is a statement about which Worker this is, not a secret.
        "SNIPSAVOR_ENV": "staging"
      }
    }
  }

  // Deliberately no WORKER_SELF_REFERENCE service binding. OpenNext only needs
  // it to drive the ISR revalidation queue, and this app has no ISR: customer
  // and admin routes are force-dynamic, and the handful of static pages are
  // served straight from assets. A self-referencing binding also cannot be
  // created on a Worker's first deploy, since the Worker does not exist yet.

  // Secrets are NOT set here. SUPABASE_SERVICE_ROLE_KEY (and RESEND_API_KEY,
  // if used) are Worker secrets - see README, "Deploy to Cloudflare Workers".
}
