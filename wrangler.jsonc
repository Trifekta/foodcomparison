{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Must match the Worker name in the Cloudflare dashboard. Workers Builds
  // deploys to the project name, so a mismatch here is rejected at deploy time.
  "name": "foodcomparison",

  // Our own entry, which wraps the one OpenNext generates. The wrapper exists
  // only to add a `scheduled` export for the cron trigger below; every other
  // export is passed straight through. See worker/index.ts.
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-08",

  // nodejs_compat: Next.js and supabase-js need Node built-ins.
  // global_fetch_strictly_public: outbound fetch goes to the public internet
  // rather than looping back into this Worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // "Is anything still waiting?", asked by Cloudflare rather than by a
  // third-party scheduler. Every five minutes, against a promise of five: a
  // submission is chased once it has been unanswered for ten, so this is
  // frequent enough that the reminder is never much later than that and rare
  // enough to be free.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }

  // Deliberately no WORKER_SELF_REFERENCE service binding. OpenNext only needs
  // it to drive the ISR revalidation queue, and this app has no ISR: customer
  // and admin routes are force-dynamic, and the handful of static pages are
  // served straight from assets. A self-referencing binding also cannot be
  // created on a Worker's first deploy, since the Worker does not exist yet.

  // Secrets are NOT set here. SUPABASE_SERVICE_ROLE_KEY (and RESEND_API_KEY,
  // if used) are Worker secrets - see README, "Deploy to Cloudflare Workers".
}
