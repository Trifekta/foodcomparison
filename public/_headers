# Next.js fingerprints these filenames, so they can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Supplied food renders: static and never rewritten, so cache them hard.
/food/*
  Cache-Control: public, max-age=2592000, immutable

# Brand artwork, same story.
/art/*
  Cache-Control: public, max-age=2592000, immutable

# App icons. Not fingerprinted, so a month rather than forever - long enough
# that nobody refetches them, short enough that changing the mark reaches
# everybody without a new filename.
/icons/*
  Cache-Control: public, max-age=2592000

# Customer screenshots are private and never served from here, but be explicit
# that nothing under this origin should be cached by shared proxies by default.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
