# ---------------------------------------------------------------------------
# Supabase
# Project settings -> API. Copy this file to .env.local and fill it in.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security - never expose this to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Also the base of the result link in every customer message. Leave it wrong
# and the message still sends - it just arrives without a link, because a link
# to localhost in someone's WhatsApp is worse than none.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (optional)
# Leave both blank and the admin dashboard falls back to "Copy email message".
# The app works fine without them.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=SnipSavor <results@yourdomain.com>

# ---------------------------------------------------------------------------
# Reading the cart screenshot (optional, admin-only)
# With a key, the admin submission page gains an "Extract basket" button: OCR
# runs in the admin's browser and only the resulting text is structured by the
# model. Leave it blank and the button explains that it is switched off; nothing
# else changes, and /privacy adjusts its wording to match.
#
# Server-only. Never prefix it with NEXT_PUBLIC_.
# EXTRACTION_MODEL defaults to claude-opus-5; measure with `npm run
# extract:eval` before switching to claude-sonnet-5 or claude-haiku-4-5.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=

# ---------------------------------------------------------------------------
# Telling the admin a price check has arrived (strongly recommended)
#
# Every comparison is done by a person, so the minutes between a customer
# uploading a screenshot and somebody looking at it are decided entirely by
# whether a phone buzzed. Set at least one of these.
#
# Telegram - free, instant, no approval, about two minutes to set up:
#   1. Open Telegram, message @BotFather, send /newbot, follow the prompts.
#      It replies with a token like 8123456789:AAF...  -> TELEGRAM_BOT_TOKEN
#   2. Send your new bot any message (it cannot message you until you do).
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates in a browser and
#      copy "chat":{"id":123456789}  -> TELEGRAM_CHAT_ID
#   For a team, add the bot to a group and use the group's negative chat id.
#
# Leave both blank and nothing is sent; submissions work exactly the same.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts instead of (or as well as) Telegram. Needs RESEND_API_KEY above.
ADMIN_ALERT_EMAIL=

# Optional - browser push notifications. Without these the app works exactly as
# before: the result page polls, and the admin keeps Telegram/email alerts.
# Generate a pair with:  npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Who a push service should contact about our traffic. Any mailto: or https: URL.
WEB_PUSH_SUBJECT=mailto:admin@snipsavor.com

# Optional - lets a scheduler call /api/cron/chase-submissions to remind an
# admin about orders nobody has opened yet. Any long random string; the route
# refuses every request without it and is disabled entirely when it is unset.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Where "Open on Keeta" is allowed to send somebody
#
# The button goes through /go/<token>, which records the click and then
# redirects. That redirect is checked against this list first, so the endpoint
# can never be used to forward somebody to an arbitrary site - an open redirect
# on a domain customers trust is a phishing tool with our name on it.
#
# Comma-separated hostnames. Subdomains of each are included automatically, so
# "keeta.com" also allows ae.keeta.com. This REPLACES the built-in default
# rather than adding to it.
#
# Leave it blank and the default is "keeta.com". Check what Keeta actually
# serves in the UAE before launch: a host missing from this list means the
# customer is stopped with an explanation instead of being sent to the
# restaurant, which is safe but is not a working button.
# ---------------------------------------------------------------------------
KEETA_ALLOWED_HOSTS=
