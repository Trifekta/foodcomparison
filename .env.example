# ---------------------------------------------------------------------------
# Supabase
# Project settings -> API. Copy this file to .env.local and fill it in.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses Row Level Security - never expose this to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (optional)
# Leave both blank and the admin dashboard falls back to "Copy email message".
# The app works fine without them.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=FindFoodae <results@yourdomain.com>

# ---------------------------------------------------------------------------
# Reading the cart screenshot (optional)
# With a key, the confirm step arrives pre-filled from the customer's
# screenshot. Leave it blank and that step simply starts empty - the wizard
# works either way, and /privacy adjusts its wording to match.
#
# Server-only. Never prefix it with NEXT_PUBLIC_.
# EXTRACTION_MODEL defaults to claude-opus-5; set it to claude-sonnet-5 or
# claude-haiku-4-5 once you have measured accuracy on your own screenshots.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=
